# ==============================================================================
# ConnectX — Production & Development Environment Variables Template
#
# FOR LOCAL DEVELOPMENT:
#   Copy this file to:
#     1) root .env (optional)
#     2) backend/.env (required for backend server)
#
# FOR VERCEL PRODUCTION DEPLOYMENT:
#   Add these variables under your Vercel Project -> Settings -> Environment Variables.
#   Note: In unified Vercel deployment, DO NOT set VITE_API_URL or VITE_SOCKET_URL!
#   The client automatically connects to the same origin (window.location.origin).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & DATABASE CONFIGURATION (REQUIRED IN VERCEL)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String (REQUIRED for Vercel production)
# Format: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/connectx?retryWrites=true&w=majority
# Make sure to whitelist 0.0.0.0/0 (allow access from anywhere) in MongoDB Atlas Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/connectx?retryWrites=true&w=majority

# Cryptographic JWT Secrets (REQUIRED: generate two distinct 32+ character random strings)
# e.g.: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars_random
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_random

# Frontend Client Public Domain (OPTIONAL on Vercel)
# On Vercel, this automatically resolves to https://$VERCEL_PROJECT_PRODUCTION_URL or https://$VERCEL_URL.
# If using a custom production domain (e.g. https://connectx.yourdomain.com), set it here:
# FRONTEND_URL=https://connectx.yourdomain.com

# ------------------------------------------------------------------------------
# 2. EMAIL & SUPPORT (OPTIONAL)
# ------------------------------------------------------------------------------
# Email Notifications via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SUPPORT_EMAIL=viratchauhan1010@gmail.com

# ------------------------------------------------------------------------------
# 3. WEBRTC STUN / TURN INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Public STUN Server for direct peer-to-peer candidate discovery
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302

# External Coturn TURN Server (traverses symmetric NATs, cellular networks, enterprise firewalls)
# Note: Coturn runs as an external server (VPS / Docker), NOT inside Vercel.
WEBRTC_TURN_SERVER=
WEBRTC_TURN_PORT=3478
WEBRTC_TURN_TLS_PORT=5349
WEBRTC_TURN_REALM=

# Authentication Option A (Recommended): Ephemeral HMAC-SHA1 tokens (RFC 5766 TURN REST API)
# Must match the `static-auth-secret` configured in your turnserver.conf
WEBRTC_TURN_SECRET=

# Authentication Option B: Static credentials (only if not using static-auth-secret)
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 4. FRONTEND CLIENT SEPARATED HOSTING OVERRIDES (DO NOT USE ON VERCEL)
# ------------------------------------------------------------------------------
# In a unified Vercel deployment (single project, single domain), leave these UNSET!
# The frontend will automatically make same-origin requests to /api and /socket.io.
# Only set these if deploying frontend and backend as two completely separate projects.
# VITE_API_URL=https://api.yourdomain.com
# VITE_SOCKET_URL=https://api.yourdomain.com
