# ==============================================================================
# ConnectX — Full-Stack Production Environment Variables Template
# Copy this file to:
#   1) root .env (for optional frontend overrides)
#   2) backend/.env (for backend runtime configuration)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB Database Connection String (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/connectx?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/connectx

# Cryptographic JWT Secrets (Generate secure random 32+ character strings)
# e.g.: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_access_key_min_16_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_16_chars

# Frontend Client Public URL (for CORS and meeting link generation)
# In unified deployment (backend serving frontend SPA), this can match your primary domain.
FRONTEND_URL=http://localhost:5173

# Email Notifications via Resend (https://resend.com)
# Optional in development; required in production for real email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SUPPORT_EMAIL=viratchauhan1010@gmail.com

# ------------------------------------------------------------------------------
# WEBRTC STUN / TURN INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Public STUN Server for direct peer-to-peer candidate discovery
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302

# Coturn TURN Server (traverses symmetric NATs, cellular carriers, and enterprise firewalls)
# Example: turn.yourdomain.com or public VPS IP address (e.g., 198.51.100.1)
WEBRTC_TURN_SERVER=
WEBRTC_TURN_PORT=3478
WEBRTC_TURN_TLS_PORT=5349
WEBRTC_TURN_REALM=

# Authentication Option A (Recommended): Ephemeral HMAC-SHA1 tokens (RFC 5766 TURN REST API)
# Must match the `static-auth-secret` configured in your turnserver.conf
WEBRTC_TURN_SECRET=

# Authentication Option B: Static credentials (only if not using static-auth-secret)
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# FRONTEND CLIENT OPTIONAL OVERRIDES (Vite)
# Only required if deploying frontend and backend to SEPARATE domains
# (e.g. Frontend on Vercel and Backend on Render)
# ------------------------------------------------------------------------------
# VITE_API_URL=https://api.yourdomain.com
# VITE_SOCKET_URL=https://api.yourdomain.com
