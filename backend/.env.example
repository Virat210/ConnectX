NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String (REQUIRED for Vercel production)
# Format: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/connectx?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/connectx?retryWrites=true&w=majority

# Cryptographic JWT Secrets (REQUIRED: generate two distinct 32+ character random strings)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars

# Frontend Client Public Domain (OPTIONAL on Vercel: auto-detected via VERCEL_URL if omitted)
FRONTEND_URL=http://localhost:5173

# Email Notifications via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SUPPORT_EMAIL=viratchauhan1010@gmail.com

# WebRTC STUN & TURN Infrastructure
# Default public Google STUN server (NAT discovery)
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302

# Coturn TURN Server Configuration (traverses symmetric NATs & restrictive firewalls)
# Example domain: turn.yourdomain.com OR public server IP (e.g. 198.51.100.1)
WEBRTC_TURN_SERVER=
WEBRTC_TURN_PORT=3478
WEBRTC_TURN_TLS_PORT=5349
WEBRTC_TURN_REALM=

# Authentication Option A (Recommended): Ephemeral time-limited HMAC-SHA1 tokens (RFC 5766 / TURN REST API)
# Set to the static-auth-secret configured in your turnserver.conf
WEBRTC_TURN_SECRET=

# Authentication Option B: Static Long-term credentials (only if not using static-auth-secret)
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
